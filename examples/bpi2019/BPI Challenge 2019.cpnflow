      },
      "position": [
        260,
        360
      ],
      "title": "Cases dated 2017 to 2019"
    },
    {
      "id": "n3",
      "box": "openprocess.flow.boxes.discover.directly_follows",
      "settings": {},
      "position": [
        520,
        600
      ],
      "title": "Process map"
    },
    {
      "id": "n4",
      "box": "openprocess.flow.boxes.filter.case_attribute",
      "settings": {
        "attribute": "Item Category",
        "values": {
          "sweep": [
            "3-way match, invoice before GR",
            "3-way match, invoice after GR",
            "Consignment",
            "2-way match"
          ]
        },
        "mode": "keep"
      },
      "position": [
        520,
        0
      ],
      "title": "One item category"
    },
    {
      "id": "n5",
      "box": "openprocess.flow.boxes.discover.inductive_miner",
      "settings": {
        "noise": 0.2
      },
      "position": [
        780,
        0
      ],
      "title": "Model of the category"
    },
    {
      "id": "n6",
      "box": "openprocess.flow.boxes.check.check_fit",
      "settings": {
        "method": "Token replay"
      },
      "position": [
        1040,
        0
      ],
      "title": "How well it fits"
    },
    {
      "id": "n7",
      "box": "openprocess.flow.boxes.sweeps.sweep_table",
