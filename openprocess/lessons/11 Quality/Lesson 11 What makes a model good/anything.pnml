<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>anything goes</text></name>
    <page id="page1">
      <place id="i"><name><text>i</text></name><initialMarking><text>1</text></initialMarking><graphics><position x="40.0" y="200.0"/><dimension x="40" y="40"/></graphics></place>
      <place id="c1"><name><text>c1</text></name><graphics><position x="260.0" y="200.0"/><dimension x="40" y="40"/></graphics></place>
      <place id="o"><name><text>o</text></name><graphics><position x="520.0" y="200.0"/><dimension x="40" y="40"/></graphics></place>
      <transition id="order"><name><text>order</text></name><graphics><position x="140.0" y="200.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="confirm"><name><text>confirm</text></name><graphics><position x="170.0" y="60.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="pay"><name><text>pay</text></name><graphics><position x="230.0" y="340.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="bake"><name><text>bake</text></name><graphics><position x="290.0" y="60.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="cancel"><name><text>cancel</text></name><graphics><position x="350.0" y="340.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="deliver"><name><text>deliver</text></name><graphics><position x="390.0" y="200.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="stop"><name><text>stop</text></name><toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="" /><graphics><position x="390.0" y="300.0"/><dimension x="40" y="40"/></graphics></transition>
      <arc id="arc1" source="i" target="order"></arc>
      <arc id="arc2" source="order" target="c1"></arc>
      <arc id="arc3" source="c1" target="confirm"></arc>
      <arc id="arc4" source="confirm" target="c1"></arc>
      <arc id="arc5" source="c1" target="pay"></arc>
      <arc id="arc6" source="pay" target="c1"></arc>
      <arc id="arc7" source="c1" target="bake"></arc>
      <arc id="arc8" source="bake" target="c1"></arc>
      <arc id="arc9" source="c1" target="cancel"></arc>
      <arc id="arc10" source="cancel" target="c1"></arc>
      <arc id="arc11" source="c1" target="deliver"></arc>
      <arc id="arc12" source="deliver" target="o"></arc>
      <arc id="arc13" source="c1" target="stop"></arc>
      <arc id="arc14" source="stop" target="o"></arc>
    </page>
    <finalmarkings><marking>
      <place idref="o"><text>1</text></place>
    </marking></finalmarkings>
  </net>
</pnml>
